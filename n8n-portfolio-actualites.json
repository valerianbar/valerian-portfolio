      "id": "ae2d219b-d7ba-4088-9380-6b0411f26b02",
      "name": "Regrouper les flux RSS"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Set();\nconst rows = [];\nfor (const item of items) {\n  const j = item.json || {};\n  const link = String(j.link || j.guid || '').trim();\n  const title = String(j.title || '').trim();\n  if (!link || !title || seen.has(link)) continue;\n  seen.add(link);\n  const dateValue = j.isoDate || j.pubDate || j.published || j.date || null;\n  const date = dateValue ? new Date(dateValue) : null;\n  rows.push({json:{title,link,description:String(j.contentSnippet || j.description || j.content || '').replace(/<[^>]*>/g,' ').replace(/\\s+/g,' ').trim().slice(0,4000),source:String(j.creator || j.author || j.feedTitle || 'Actualités IA'),published_at:date && !Number.isNaN(date.getTime()) ? date.toISOString() : null}});\n}\nrows.sort((a,b)=>(Date.parse(b.json.published_at||0)||0)-(Date.parse(a.json.published_at||0)||0));\nreturn rows.slice(0,50);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        160
      ],
      "id": "340bd548-9ee0-48bc-8853-d044cb8d13cc",
      "name": "Normaliser et dédupliquer"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (INSERT INTO portfolio_articles (link,title,description,source,published_at,summary) SELECT $1,$2,$3,$4,$5::timestamptz,$6 WHERE (SELECT COUNT(*) FROM portfolio_articles WHERE created_at >= date_trunc('day', NOW())) < 10 ON CONFLICT (link) DO NOTHING RETURNING id) SELECT id FROM inserted;",
        "options": {
          "queryReplacement": "={{ [$('Normaliser et dédupliquer').item.json.link, $('Normaliser et dédupliquer').item.json.title, $('Normaliser et dédupliquer').item.json.description, $('Normaliser et dédupliquer').item.json.source, $('Normaliser et dédupliquer').item.json.published_at, $json.choices[0].message.content.trim()] }}"
        }
      },
